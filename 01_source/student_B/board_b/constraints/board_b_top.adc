set_pin_assignment { sys_clk }    { LOCATION = R7;  IOSTANDARD = LVCMOS33; PULLTYPE = NONE; }
set_pin_assignment { sys_rst_n }  { LOCATION = A2;  IOSTANDARD = LVCMOS33; PULLTYPE = PULLUP; }
set_pin_assignment { key2_n }     { LOCATION = B2;  IOSTANDARD = LVCMOS33; PULLTYPE = PULLUP; }
set_pin_assignment { key3_n }     { LOCATION = B1;  IOSTANDARD = LVCMOS33; PULLTYPE = PULLUP; }
set_pin_assignment { key4_n }     { LOCATION = C1;  IOSTANDARD = LVCMOS33; PULLTYPE = PULLUP; }
set_pin_assignment { uart_tx_o }  { LOCATION = D12; IOSTANDARD = LVCMOS33; DRIVESTRENGTH = 8; PULLTYPE = NONE; }
# Feature link from Board A on header J2-2 (N4), 921600-8N1; uart_tx_o above
# stays on the CH340 (D12) for the 115200 SCORE lines -- docs/13 section 3
set_pin_assignment { uart_rx_i }  { LOCATION = N4;  IOSTANDARD = LVCMOS33; PULLTYPE = PULLUP; }
# Return packets to Board A on header J2-1 (P4), 921600-8N1 (docs/14 section 3)
set_pin_assignment { link_tx_o }  { LOCATION = P4;  IOSTANDARD = LVCMOS33; DRIVESTRENGTH = 8; PULLTYPE = NONE; }
